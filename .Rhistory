library(readxl)
library(dplyr)
library(ggplot2)
library(MASS)   # glm.nb
library(AER)    # dispersiontest  — install.packages("AER") if needed
# ── Load data ──────────────────────────────────────────────────────────────
df <- read_excel("D:/PhD coursework/GRA/VAR_LASSO/data_mpox.xlsx")
cat("=== Data overview ===\n")
cat("Rows:", nrow(df), "| Cols:", ncol(df), "\n")
cat("Columns:", paste(names(df), collapse = ", "), "\n\n")
# ── 8 key jurisdictions, modeling period ──────────────────────────────────
key_j <- c("NewYorkCity", "Texas", "LA", "Florida", "Illinois",
"Georgia", "SanDiego", "Washington")
df_key <- df |>
filter(Jurisdiction %in% key_j,
as.Date(date_week_start) >= as.Date("2023-01-01")) |>
mutate(date = as.Date(date_week_start),
Year = format(date, "%Y"))
# ── 1. Per-jurisdiction dispersion stats ───────────────────────────────────
cat("=== Dispersion statistics (2023-2024) ===\n")
disp <- df_key |>
group_by(Jurisdiction) |>
summarise(
n          = n(),
mean       = mean(Cases),
var        = var(Cases),
disp_ratio = var(Cases) / mean(Cases),  # >1 = overdispersed vs Poisson
prop_zero  = mean(Cases == 0),
max        = max(Cases),
.groups    = "drop"
) |>
arrange(desc(disp_ratio))
print(as.data.frame(disp), digits = 3)
# ── 2. Formal Poisson dispersion test (AER) ────────────────────────────────
cat("\n=== Formal overdispersion test (Poisson, pooled) ===\n")
pois_fit <- glm(Cases ~ Jurisdiction + Year, data = df_key, family = poisson)
print(dispersiontest(pois_fit))
# ── 3. LR test: Poisson vs Negative Binomial ──────────────────────────────
cat("\n=== LR test: Negative Binomial vs Poisson ===\n")
nb_fit  <- glm.nb(Cases ~ Jurisdiction + Year, data = df_key)
lr_stat <- 2 * (logLik(nb_fit) - logLik(pois_fit))
cat("LR statistic:", round(lr_stat, 2),
"| p-value:", format.pval(pchisq(lr_stat, df = 1, lower.tail = FALSE), digits = 4), "\n")
cat("NB theta:", round(nb_fit$theta, 3), " (smaller = more overdispersion)\n")
# ── 4. Per-jurisdiction NB theta ───────────────────────────────────────────
cat("\n=== Per-jurisdiction NB theta ===\n")
for (j in key_j) {
sub <- df_key |> filter(Jurisdiction == j)
tryCatch({
fit <- glm.nb(Cases ~ 1, data = sub)
cat(sprintf("%-20s  theta = %6.3f   var/mean = %5.2f\n",
j, fit$theta, var(sub$Cases) / mean(sub$Cases)))
}, error = function(e) cat(j, ": NB fit failed\n"))
}
# ── 5. Zero-inflation: observed vs Poisson-expected zeros ─────────────────
cat("\n=== Zero-inflation check ===\n")
df_key |>
group_by(Jurisdiction) |>
summarise(
n              = n(),
mu             = mean(Cases),
obs_zeros      = sum(Cases == 0),
exp_pois_zeros = round(n * exp(-mu), 1),
excess_zeros   = obs_zeros - round(n * exp(-mu), 1),
.groups        = "drop"
) |>
as.data.frame() |>
print()
# ── 6. Variance-mean plot ──────────────────────────────────────────────────
p <- ggplot(disp, aes(x = mean, y = var, label = Jurisdiction)) +
geom_abline(slope = 1, intercept = 0, linetype = "dashed",
color = "steelblue", linewidth = 0.8) +
geom_point(aes(color = disp_ratio), size = 4) +
geom_text(vjust = -0.7, size = 3.2) +
scale_color_gradient(low = "#1D9E75", high = "#D85A30", name = "Var/Mean") +
scale_x_continuous(limits = c(0, NA)) +
scale_y_continuous(limits = c(0, NA)) +
labs(
title    = "Variance vs mean: 8 jurisdictions (2023-2024)",
subtitle = "Dashed line = Poisson (var = mean). Points above = overdispersed.",
x = "Mean weekly cases", y = "Variance of weekly cases"
) +
theme_minimal(base_size = 12) +
theme(plot.title = element_text(face = "bold"))
print(p)
ggsave("D:/PhD coursework/GRA/VAR_LASSO/mpox_dispersion_plot.png",
p, width = 8, height = 5.5, dpi = 150)
# ── 7. Summary recommendation ─────────────────────────────────────────────
cat("\n=== Summary ===\n")
med_ratio <- median(disp$disp_ratio)
med_zeros <- median(disp$prop_zero)
cat(sprintf("Median var/mean ratio: %.2f\n", med_ratio))
cat(sprintf("Median proportion zero weeks: %.1f%%\n", med_zeros * 100))
if (med_ratio > 2 & med_zeros > 0.3) {
cat("\nVerdict: Substantially overdispersed AND zero-inflated.\n")
cat("  Primary recommendation : Negative Binomial error structure\n")
cat("  If zeros persist after NB: consider ZINB or Hurdle-NB\n")
cat("  Gaussian VAR assumption : likely violated\n")
} else if (med_ratio > 1.5) {
cat("\nVerdict: Moderate overdispersion — NB preferred over Poisson.\n")
} else {
cat("\nVerdict: Mild overdispersion — Poisson may be adequate.\n")
}
library(dagitty)
library(ggdag)
library(ggplot2)
library(dplyr)
dag <- dagitty('dag {
BLL
HTN
IV
Age
BLL -> HTN
IV -> BLL
Age -> HTN
Age -> BLL
}')
exposures(dag) <- c("BLL")
outcomes(dag)  <- c("HTN")
# Node sizes scaled by label length
node_sizes <- c(
"BLL" = 15,
"HTN" = 15,
"IV" = 14,
"Age" = 15
)
# Build tidy DAG
dag_tidy <- tidy_dagitty(dag, layout = "nicely", seed = 42)
dag_tidy$data <- dag_tidy$data %>%
mutate(node_size = node_sizes[name])
# Plot: white fill, black border, black text, size-scaled
# Shorten edges so arrowheads land outside node circles
edges_df <- dag_tidy$data[!is.na(dag_tidy$data$xend), ]
nodes_df  <- dag_tidy$data[!duplicated(dag_tidy$data$name) & !is.na(dag_tidy$data$x), ]
# Compute shortened endpoints
r_scale <- 0.12  # approximate node radius in layout units
dx <- edges_df$xend - edges_df$x
dy <- edges_df$yend - edges_df$y
len <- sqrt(dx^2 + dy^2)
edges_df$x2 <- edges_df$xend - (dx / len) * r_scale
edges_df$y2 <- edges_df$yend - (dy / len) * r_scale
edges_df$x1 <- edges_df$x    + (dx / len) * r_scale * 0.5
edges_df$y1 <- edges_df$y    + (dy / len) * r_scale * 0.5
ggplot() +
geom_segment(
data = edges_df,
aes(x = x1, y = y1, xend = x2, yend = y2),
arrow = arrow(length = unit(6, "pt"), type = "closed", ends = "last"),
colour = "black", linewidth = 0.5
) +
geom_point(
data = nodes_df,
aes(x = x, y = y, size = node_size),
shape = 21, fill = "white", color = "black",
stroke = 1.2, show.legend = FALSE
) +
scale_size_identity() +
geom_text(
data = nodes_df,
aes(x = x, y = y, label = name),
color = "black", size = 3.0
) +
theme_void() +
theme(plot.background = element_rect(fill = "white", color = NA))
# Instrumental variable: IV
# Verify: (1) IV->Exposure edge present, (2) no IV->Outcome direct path, (3) IV independent of unmeasured confounders
# Minimal adjustment sets
adjustmentSets(dag, exposure = "BLL", outcome = "HTN")
# Implied conditional independencies
impliedConditionalIndependencies(dag)
